{
  "name": "phimanh-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "dev": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "clean": "rm -rf node_modules .expo dist web-build",
    "eas:build:dev": "eas build --profile development --platform android",
    "eas:build:apk": "eas build --profile preview --platform android --local",
    "eas:build:apk:remote": "eas build --profile preview --platform android",
    "eas:build:prod": "eas build --profile production --platform android",
    "eas:build:ios": "eas build --profile production --platform ios",
    "eas:submit": "eas submit --platform android --latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@tanstack/react-query": "^5.90.19",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "^57.0.27",
    "expo-blur": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-screen-orientation": "^57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "expo-video": "^57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
