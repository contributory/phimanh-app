<?xml version="1.0" encoding="utf-8"?>
<!-- Copy file nay vao android/app/src/main/res/xml/network_security_config.xml
     sau khi chay `npx cap add android`, de cho phep stream HLS http:// tren Android 9+. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
